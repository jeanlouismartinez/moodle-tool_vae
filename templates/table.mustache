{{!
    @template tool_vae/table

    A table of the core (html_table), with the DOM the core writes for it: the wrapper "table-responsive", the caption,
    the headings, the rows and their cells, or an empty body over every column when there is no row.

    Every attribute comes from the context, already worked out by tool_vae\output\table as the core works it out; the
    template holds no logic beyond its sections. Every name and value of an attribute is escaped (double braces).
    One key is HTML, placed as it is (triple braces): texthtml, the text of a heading, of the caption or of a cell, which
    an html_table holds as HTML and the core places as it is; the code that fills the table escapes what it puts in, and a
    renderable of the plugin in a cell is drawn by the renderer of the plugin before it gets here.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * responsive - bool, whether the table is wrapped in a block "table-responsive"
    * attributes - array of {name, value}, the attributes of the table
    * caption - false, or {attributes, texthtml}: the caption of the table
    * hashead - bool, whether the table has headings
    * head - array of headings, each {isth, attributes, texthtml}: a th when isth, otherwise a td
    * emptybody - false, or {colspan}: the empty body drawn when there are headings and no row
    * hasbody - bool, whether the table has rows
    * rows - array of rows, each {attributes, cells}; each cell {isth, attributes, texthtml}

    Example context (json):
    {
        "responsive": true,
        "attributes": [{"name": "class", "value": "generaltable tool-vae-pending"}],
        "caption": {"attributes": [{"name": "class", "value": "visually-hidden"}], "texthtml": "Declarations awaiting"},
        "hashead": true,
        "head": [
            {"isth": true, "attributes": [{"name": "class", "value": "header c0"}, {"name": "style", "value": ""},
                {"name": "scope", "value": "col"}], "texthtml": "Candidate"},
            {"isth": false, "attributes": [{"name": "class", "value": "header c1 lastcol"}, {"name": "style", "value": ""}],
                "texthtml": ""}
        ],
        "emptybody": false,
        "hasbody": true,
        "rows": [
            {"attributes": [{"name": "class", "value": "lastrow"}], "cells": [
                {"isth": true, "attributes": [{"name": "class", "value": "cell c0"}, {"name": "style", "value": ""},
                    {"name": "scope", "value": "row"}], "texthtml": "Camille Durand"},
                {"isth": false, "attributes": [{"name": "class", "value": "cell c1 lastcol"}, {"name": "style", "value": ""}],
                    "texthtml": "6"}
            ]}
        ]
    }
}}
{{#responsive}}
<div class="table-responsive">
{{/responsive}}
<table{{#attributes}} {{name}}="{{value}}"{{/attributes}}>
{{#caption}}
<caption{{#attributes}} {{name}}="{{value}}"{{/attributes}}>{{{texthtml}}}</caption>
{{/caption}}
{{#hashead}}
<thead>
<tr>
{{#head}}
{{#isth}}<th{{#attributes}} {{name}}="{{value}}"{{/attributes}}>{{{texthtml}}}</th>{{/isth}}
{{^isth}}<td{{#attributes}} {{name}}="{{value}}"{{/attributes}}>{{{texthtml}}}</td>{{/isth}}
{{/head}}
</tr>
</thead>
{{/hashead}}
{{#emptybody}}
<tbody class="empty"><tr><td colspan="{{colspan}}"></td></tr></tbody>
{{/emptybody}}
{{#hasbody}}
<tbody>
{{#rows}}
<tr{{#attributes}} {{name}}="{{value}}"{{/attributes}}>
{{#cells}}
{{#isth}}<th{{#attributes}} {{name}}="{{value}}"{{/attributes}}>{{{texthtml}}}</th>{{/isth}}
{{^isth}}<td{{#attributes}} {{name}}="{{value}}"{{/attributes}}>{{{texthtml}}}</td>{{/isth}}
{{/cells}}
</tr>
{{/rows}}
</tbody>
{{/hasbody}}
</table>
{{#responsive}}
</div>
{{/responsive}}
