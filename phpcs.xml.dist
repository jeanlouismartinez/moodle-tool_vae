<?xml version="1.0"?>
<ruleset name="tool_vae">
    <description>
        Moodle coding standard applied to the plugin.

        No exclusion but generated and third-party code: a standard with a list of exceptions ends up being nothing
        but a list of exceptions. scripts/ holds no PHP since 19 November 2026 (the command line script of the
        plugin is a Moodle script, in cli/), so it is no longer excluded.
    </description>

    <rule ref="moodle"/>

    <exclude-pattern>*/amd/build/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
</ruleset>
